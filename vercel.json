{
  "version": 2,
  "builds": [
    {
      "src": "backend/server.js",
      "use": "@vercel/node"
    },
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/backend/server.js"
    },
    {
      "src": "/assets/(.*)",
      "dest": "/frontend/dist/assets/$1"
    },
    {
      "src": "/pwa-icon.jpg",
      "dest": "/frontend/dist/pwa-icon.jpg"
    },
    {
      "src": "/favicon.svg",
      "dest": "/frontend/dist/favicon.svg"
    },
    {
      "src": "/sw.js",
      "dest": "/frontend/dist/sw.js"
    },
    {
      "src": "/workbox-(.*).js",
      "dest": "/frontend/dist/workbox-$1.js"
    },
    {
      "src": "/manifest.webmanifest",
      "dest": "/frontend/dist/manifest.webmanifest"
    },
    {
      "src": "/(.*)",
      "dest": "/frontend/dist/index.html"
    }
  ]
}
